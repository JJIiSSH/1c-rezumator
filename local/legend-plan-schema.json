{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "type": "string"
    },
    "employers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "team_process": {
            "type": "string",
            "description": "Роли, постановка и планирование задач, методология/ритм, ревью, тестирование, приёмка и выпуск. Недельное планирование само по себе не Scrum. Реконструкцию отметить в proposals."
          },
          "scale": {
            "type": "string"
          },
          "stack": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "company",
          "role",
          "period",
          "context",
          "team_process",
          "scale",
          "stack"
        ]
      },
      "minItems": 1,
      "maxItems": 2
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "employer_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "standard_gap": {
            "type": "string"
          },
          "own_contribution": {
            "type": "string",
            "description": "Что лично написал или изменил в 1С, механизм реализации и границы участия коллег; сбор требований не заменяет разработку."
          },
          "solution": {
            "type": "string",
            "description": "3-5 связанных предложений: реализация на механизме 1С, техническая сложность или выбор, диагностика причины, конкретное изменение и проверка. Пример с СКД/запросами не обязателен всем. Реконструкцию отметить в proposals."
          },
          "data_example": {
            "type": "string"
          },
          "verification": {
            "type": "string",
            "description": "Проверка корректности и граничных случаев; для оптимизации сравнение на одинаковых данных/параметрах, без новых чисел при выключенных метриках."
          },
          "result": {
            "type": "string"
          },
          "limits": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "employer_id",
          "title",
          "problem",
          "standard_gap",
          "own_contribution",
          "solution",
          "data_example",
          "verification",
          "result",
          "limits"
        ]
      },
      "minItems": 3,
      "maxItems": 4
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "mistake": {
            "type": "string"
          },
          "detection": {
            "type": "string"
          },
          "test_consequences": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          },
          "prevention": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "enum": [
              "test",
              "local_copy",
              "preprod"
            ]
          }
        },
        "required": [
          "case_id",
          "context",
          "mistake",
          "detection",
          "test_consequences",
          "fix",
          "verification",
          "prevention",
          "environment"
        ]
      },
      "minItems": 2,
      "maxItems": 3
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 0,
      "maxItems": 5
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "profile",
    "employers",
    "cases",
    "failures",
    "questions",
    "proposals"
  ]
}
